<resources>
    <!-- The bottom line: the search bar and the floating action, and the gap around and between them. -->
    <dimen name="bottom_line_gap">16dp</dimen>
    <dimen name="bottom_line_height">56dp</dimen>
    <!-- bottom_line_gap + bottom_line_height + bottom_line_gap, so a list's last row can be
         scrolled clear of the line. Keep in step with the two above. -->
    <dimen name="list_bottom_line_clearance">88dp</dimen>
    <!-- How far above the bottom line's controls its fade of the page colour begins. A
         smoothstep ramp after Napper's list foot, shortened to the user's taste. -->
    <dimen name="bottom_line_fade">36dp</dimen>
    <!-- list_bottom_line_clearance plus just over half of bottom_line_fade, so a list under the
         fade scrolls its last row's ink up to where the fade is still light. Keep in step with
         the two above. -->
    <dimen name="list_bottom_fade_clearance">108dp</dimen>
    <!-- A row of controls resting above the line's controls, not dissolving under them: the
         controls' height and gap, plus the gap again above their top edge, less the card margin
         the row already carries. 16 + 56 + 16 - 6. -->
    <dimen name="bottom_line_rest_clearance">82dp</dimen>
    <!-- Inset plus half an icon button puts the glyph's centre 28dp from the bar's edge and the
         hint's ink 56dp in, the leading rhythm of a Material search bar, with 48dp touch targets. -->
    <dimen name="search_bar_inset">4dp</dimen>
    <dimen name="search_bar_icon_size">48dp</dimen>
    <dimen name="search_bar_field_gap">4dp</dimen>
    <dimen name="margin_activity">25dp</dimen>

    <!-- Unified settings spacing -->
    <dimen name="settings_item_gap">16dp</dimen>
    <dimen name="settings_label_control_gap">16dp</dimen>
    <dimen name="settings_section_gap">24dp</dimen>
    <!-- Under the app bar. Chrome's sub-screens draw a first category title's cap height 21dp below the bar;
         labelLarge carries 5dp of leading above the caps, so 16dp of padding lands the ink there.
         A screen that opens with a surface uses the section gap under the bar, as between its surfaces. -->
    <dimen name="settings_title_top_gap">16dp</dimen>
    <!-- Identity card: 24dp inside above the icon and below the last text line; the row's own 8dp padding is part of it -->
    <dimen name="settings_identity_inset_top">16dp</dimen>
    <dimen name="settings_identity_inset_bottom">16dp</dimen>
    <dimen name="divider_height">1dp</dimen>
    <dimen name="dialog_list_top_padding">16dp</dimen>
    <dimen name="dialog_content_horizontal_padding">24dp</dimen>
    <dimen name="dialog_content_top_padding">16dp</dimen>
    <dimen name="dialog_subheader_gap_top">16dp</dimen>
    <dimen name="dialog_subheader_gap_bottom">8dp</dimen>
    <dimen name="dialog_content_gap">16dp</dimen>

    <dimen name="popup_menu_corner_radius">16dp</dimen>
    <!-- Chrome's settings bar (default_action_bar_height); Material 3's actionBarSize is 64dp -->
    <dimen name="toolbar_height">56dp</dimen>

    <!-- Segmented settings groups: rows on colorSurfaceContainer joined by seams -->
    <dimen name="settings_group_corner_outer">16dp</dimen>
    <dimen name="settings_group_corner_inner">4dp</dimen>
    <dimen name="settings_group_seam">2dp</dimen>
    <dimen name="settings_row_min_height">72dp</dimen>
    <dimen name="settings_row_padding_horizontal">16dp</dimen>
    <dimen name="settings_row_padding_vertical">8dp</dimen>
    <dimen name="settings_entry_min_height">48dp</dimen>
    <dimen name="settings_row_label_gap">4dp</dimen>
    <dimen name="settings_icon_slot_width">40dp</dimen>
    <!-- Title baseline sits 21dp above its group (Chrome); 4dp of descent leading below the baseline is inside the text box -->
    <dimen name="settings_title_gap_bottom">17dp</dimen>
    <dimen name="settings_touch_target">48dp</dimen>
    <!-- 48dp touch-target line minus 14dp puts one-line labelLarge text at the section gap; 2dp rest completes the 16dp gap below -->
    <dimen name="settings_header_pull_up">-14dp</dimen>
    <dimen name="settings_header_pull_up_rest">2dp</dimen>
    <dimen name="settings_nested_row_inset">40dp</dimen>

    <dimen name="settings_screen_inset">12dp</dimen>

    <dimen name="list_card_margin_horizontal">12dp</dimen>
    <dimen name="list_card_margin_vertical">6dp</dimen>
    <dimen name="list_card_padding_horizontal">16dp</dimen>
    <dimen name="list_card_padding_vertical">12dp</dimen>
    <dimen name="list_card_list_padding_top">6dp</dimen>
    <!-- A suggestion row is a 24dp glyph in a 48dp touch target: about half a web-app row. -->
    <dimen name="suggestion_card_min_height">48dp</dimen>
    <dimen name="suggestion_card_padding_vertical">8dp</dimen>
    <dimen name="suggestion_icon_size">24dp</dimen>
    <dimen name="settings_dropdown_max_width">160dp</dimen>
    <dimen name="toolbar_label_max_width">140dp</dimen>

    <!-- Floating controls panel + trigger -->
    <dimen name="floating_controls_button_size">36dp</dimen>
    <dimen name="floating_controls_button_gap">16dp</dimen>
    <dimen name="floating_controls_panel_padding">8dp</dimen>
    <dimen name="floating_controls_panel_trigger_gap">8dp</dimen>
    <dimen name="floating_controls_divider_inset">6dp</dimen>
    <dimen name="floating_controls_corner_radius">18dp</dimen>
    <dimen name="floating_controls_elevation">6dp</dimen>

    <!-- Indicator dot -->
    <dimen name="indicator_dot_size">8dp</dimen>
    <dimen name="indicator_dot_inset">2dp</dimen>

    <!-- Bottom controls bar -->
    <dimen name="bar_controls_margin">8dp</dimen>
    <dimen name="bar_controls_margin_bottom">16dp</dimen>
    <dimen name="bar_controls_min_height">48dp</dimen>
    <dimen name="bar_controls_padding_horizontal">8dp</dimen>
    <dimen name="bar_controls_slot_width">44dp</dimen>
    <dimen name="bar_controls_button_gap">4dp</dimen>
    <dimen name="bar_controls_scroll_threshold">24dp</dimen>
    <!-- Swipe-up strip along the bottom edge that reveals the hidden bar. -->
    <dimen name="bar_controls_edge_trigger_height">48dp</dimen>

    <!-- Find-in-page bar -->
    <dimen name="find_in_page_margin">8dp</dimen>
    <dimen name="find_in_page_elevation">6dp</dimen>
    <dimen name="find_in_page_min_height">48dp</dimen>
    <dimen name="find_in_page_button_gap">2dp</dimen>

    <!-- Virtual cursor (D-pad hosts) -->
    <dimen name="virtual_cursor_size">24dp</dimen>
    <dimen name="virtual_cursor_elevation">8dp</dimen>
    <dimen name="tab_badge_horizontal_offset">0dp</dimen>
    <dimen name="tab_badge_vertical_offset">4dp</dimen>
</resources>
