<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="actionBarSize">@dimen/toolbar_height</item>
        <item name="materialSearchViewStyle">@style/Widget.App.SearchView</item>
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_onPrimary</item>
        <item name="colorPrimaryContainer">@color/brand_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/brand_onPrimaryContainer</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/brand_onSecondary</item>
        <item name="colorSecondaryContainer">@color/brand_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/brand_onSecondaryContainer</item>
        <item name="colorTertiary">@color/brand_tertiary</item>
        <item name="colorOnTertiary">@color/brand_onTertiary</item>
        <item name="colorTertiaryContainer">@color/brand_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/brand_onTertiaryContainer</item>
        <item name="colorError">@color/brand_error</item>
        <item name="colorOnError">@color/brand_onError</item>
        <item name="colorErrorContainer">@color/brand_errorContainer</item>
        <item name="colorOnErrorContainer">@color/brand_onErrorContainer</item>
        <item name="android:colorBackground">@color/brand_background</item>
        <item name="colorOnBackground">@color/brand_onBackground</item>
        <item name="colorSurface">@color/brand_surface</item>
        <item name="colorOnSurface">@color/brand_onSurface</item>
        <item name="colorSurfaceVariant">@color/brand_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/brand_onSurfaceVariant</item>
        <item name="colorOutline">@color/brand_outline</item>
        <item name="colorOutlineVariant">@color/brand_outlineVariant</item>
        <item name="colorSurfaceInverse">@color/brand_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/brand_inverseOnSurface</item>
        <item name="colorPrimaryInverse">@color/brand_inversePrimary</item>
        <item name="colorSurfaceDim">@color/brand_surfaceDim</item>
        <item name="colorSurfaceBright">@color/brand_surfaceBright</item>
        <item name="colorSurfaceContainerLowest">@color/brand_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/brand_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/brand_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/brand_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/brand_surfaceContainerHighest</item>
        <item name="android:windowBackground">?attr/colorSurfaceContainerLow</item>
        <item name="popupMenuBackground">@drawable/popup_menu_background_rounded</item>
        <item name="autoCompleteTextViewStyle">@style/Widget.App.AutoCompleteTextView</item>
    </style>

    <style name="AppTheme.Launcher">
        <item name="android:windowBackground">@drawable/launch_screen</item>
    </style>

    <style name="AppTheme.Transparent" parent="AppTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="AppTheme.PickerSurface" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.App.PickerSheet</item>
        <item name="android:windowSoftInputMode">adjustResize|stateHidden</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
    </style>

    <!-- The list runs under the navigation bar to the screen's edge, as the web-app list does;
         the list pads its own foot instead of the sheet. -->
    <style name="Widget.App.PickerSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?attr/colorSurfaceContainerLow</item>
        <item name="paddingBottomSystemWindowInsets">false</item>
    </style>

    <style name="AppTheme.Trampoline" parent="AppTheme">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="AppTheme.Browser" parent="AppTheme" />

    <style name="SettingsRow.Inline" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="SettingsSurfaceRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/settings_row_min_height</item>
        <item name="android:paddingHorizontal">@dimen/settings_row_padding_horizontal</item>
        <item name="android:paddingVertical">@dimen/settings_row_padding_vertical</item>
    </style>

    <style name="SettingsSurfaceRow.Inline">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="SettingsSurfaceRow.Line">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/settings_entry_min_height</item>
        <item name="android:paddingHorizontal">0dp</item>
        <item name="android:paddingVertical">0dp</item>
    </style>

    <style name="SettingsSurfaceRow.Hairline">
        <item name="android:layout_height">@dimen/divider_height</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingHorizontal">0dp</item>
        <item name="android:paddingVertical">0dp</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
    </style>

    <style name="SettingsEntryText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.App.SearchView" parent="Widget.Material3Expressive.SearchView.AppBarWithSearch">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.SearchView</item>
    </style>

    <style name="ThemeOverlay.App.SearchView" parent="ThemeOverlay.Material3Expressive.SearchView.AppBarWithSearch">
        <item name="materialSearchViewToolbarStyle">@style/Widget.App.SearchView.Toolbar</item>
    </style>

    <!-- The library's 4dp top margin aligns the pill with a SearchBar inside an AppBarLayout; Peel has no
         SearchBar, so the pill's bottom edge sits on the app bar's and the rows below keep their page rhythm. -->
    <style name="Widget.App.SearchView.Toolbar" parent="Widget.Material3Expressive.SearchView.Toolbar.AppBarWithSearch">
        <item name="android:layout_marginTop">0dp</item>
    </style>

    <!-- The bottom line owns the window insets for every control on it, so the bar's own
         inset margins are off. The container's padding leaves the leading icon 16dp from the
         bar's edge, matching a search bar's leading margin. -->
    <style name="Widget.App.SearchBar" parent="Widget.Material3.FloatingToolbar">
        <item name="android:minHeight">@dimen/bottom_line_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">@dimen/search_bar_inset</item>
        <item name="android:paddingEnd">@dimen/search_bar_inset</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="marginLeftSystemWindowInsets">false</item>
        <item name="marginRightSystemWindowInsets">false</item>
        <item name="marginBottomSystemWindowInsets">false</item>
    </style>

    <style name="Widget.App.SearchBar.Icon" parent="">
        <item name="android:layout_width">@dimen/search_bar_icon_size</item>
        <item name="android:layout_height">@dimen/search_bar_icon_size</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.App.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.TabLayout</item>
    </style>

    <style name="ThemeOverlay.App.TabLayout" parent="">
        <item name="badgeStyle">@style/Widget.App.Badge</item>
    </style>

    <style name="Widget.App.Badge" parent="Widget.Material3.Badge">
        <item name="backgroundColor">?attr/colorPrimary</item>
        <item name="badgeTextColor">?attr/colorOnPrimary</item>
        <item name="horizontalOffsetWithText">@dimen/tab_badge_horizontal_offset</item>
        <item name="verticalOffsetWithText">@dimen/tab_badge_vertical_offset</item>
    </style>

    <style name="Widget.App.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextAppearance">?attr/textAppearanceTitleLarge</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.App.ListCard" parent="Widget.Material3.CardView.Elevated">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">@dimen/list_card_margin_horizontal</item>
        <item name="android:layout_marginVertical">@dimen/list_card_margin_vertical</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerHigh</item>
    </style>

    <!-- A suggestion is a lighter kind of result: the list card's shape and rhythm at half the
         height, one tone down, so it reads as something to act on rather than something had. -->
    <style name="Widget.App.SuggestionCard" parent="Widget.App.ListCard">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
    </style>

    <!-- The link the picker opens, in the search bar's pill: the same fill, shape and height,
         so the two read as one pair of fields. -->
    <style name="Widget.App.PickerLinkCard" parent="Widget.App.ListCard">
        <item name="android:layout_marginVertical">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
    </style>

    <!-- The picker's link actions, as the system share sheet shows its own: a row of buttons
         with a leading icon under the link, in the web-app cards' tone. -->
    <style name="Widget.App.PickerAction" parent="Widget.Material3.Button.TonalButton.Icon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="backgroundTint">?attr/colorSurfaceContainerHigh</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- The link as one line in the search bar's columns: the link icon centred on its
         magnifier (12dp + 16dp + 12dp = 12dp + 4dp + 24dp) and the address starting where its
         query does (68dp), in the cards' address grey. -->
    <style name="PickerLinkRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/bottom_line_height</item>
        <item name="android:paddingStart">@dimen/list_card_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/list_card_padding_horizontal</item>
        <item name="android:drawablePadding">@dimen/list_card_padding_horizontal</item>
        <item name="drawableTint">?attr/colorOnSurfaceVariant</item>
        <item name="android:ellipsize">middle</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textDirection">ltr</item>
    </style>

    <style name="SuggestionCardRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/suggestion_card_min_height</item>
        <item name="android:paddingHorizontal">@dimen/list_card_padding_horizontal</item>
        <item name="android:paddingVertical">@dimen/suggestion_card_padding_vertical</item>
        <item name="android:drawablePadding">@dimen/list_card_padding_horizontal</item>
        <item name="drawableTint">?attr/colorOnSurfaceVariant</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>


    <style name="ListCardContent">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">@dimen/list_card_padding_horizontal</item>
        <item name="android:paddingVertical">@dimen/list_card_padding_vertical</item>
    </style>

    <style name="Widget.App.AutoCompleteTextView" parent="Widget.Material3.AutoCompleteTextView.OutlinedBox">
        <item name="android:popupBackground">@drawable/popup_menu_background_rounded</item>
    </style>

    <style name="Widget.App.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
        <item name="iconSize">24dp</item>
    </style>

    <style name="SettingsIconButton" parent="Widget.App.IconButton" />

    <style name="SettingsIconButton.Slot">
        <item name="android:minWidth">@dimen/settings_icon_slot_width</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <style name="SettingsTextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
        <item name="iconGravity">end</item>
        <item name="iconPadding">4dp</item>
        <item name="icon">@drawable/ic_symbols_keyboard_arrow_down_24</item>
    </style>

    <style name="Widget.App.FloatingIconButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">@dimen/floating_controls_button_size</item>
        <item name="android:layout_height">@dimen/floating_controls_button_size</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="tint">@color/floating_action_tint</item>
    </style>

</resources>
