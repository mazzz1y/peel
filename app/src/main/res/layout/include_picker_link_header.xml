<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/list_card_list_padding_top">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/pickerLinkCard"
        style="@style/Widget.App.SuggestionCard"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp">

        <TextView
            android:id="@+id/pickerLink"
            style="@style/SuggestionCardRow"
            android:ellipsize="middle"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:drawableStartCompat="@drawable/ic_symbols_link_24" />

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/pickerLinkActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/picker_action_card_margin">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/pickerIncognito"
            style="@style/Widget.App.PickerActionCard.Half">

            <TextView
                style="@style/SuggestionCardRow"
                android:text="@string/incognito"
                app:drawableStartCompat="@drawable/ic_symbols_visibility_off_24" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/pickerShare"
            style="@style/Widget.App.PickerActionCard.Half">

            <TextView
                style="@style/SuggestionCardRow"
                android:text="@string/share"
                app:drawableStartCompat="@drawable/ic_symbols_share_24" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/pickerAdd"
        style="@style/Widget.App.PickerActionCard"
        android:visibility="gone">

        <TextView
            style="@style/SuggestionCardRow"
            android:text="@string/add_webapp"
            app:drawableStartCompat="@drawable/ic_symbols_add_24" />

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
