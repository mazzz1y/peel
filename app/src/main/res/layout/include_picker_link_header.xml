<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pickerHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/pickerLinkCard"
        style="@style/Widget.App.PickerLinkCard">

        <TextView
            android:id="@+id/pickerLink"
            style="@style/PickerLinkRow"
            app:drawableStartCompat="@drawable/ic_symbols_link_24" />

    </com.google.android.material.card.MaterialCardView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/picker_action_row_margin_top"
        android:layout_marginBottom="@dimen/picker_action_row_margin_bottom"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/list_card_margin_horizontal"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:divider="@drawable/picker_action_gap"
            android:orientation="horizontal"
            android:showDividers="middle">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pickerSearch"
                style="@style/Widget.App.PickerAction"
                android:text="@string/search"
                app:icon="@drawable/ic_symbols_search_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pickerIncognito"
                style="@style/Widget.App.PickerAction"
                android:text="@string/incognito"
                app:icon="@drawable/ic_symbols_visibility_off_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pickerShare"
                style="@style/Widget.App.PickerAction"
                android:text="@string/share"
                app:icon="@drawable/ic_symbols_share_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pickerAdd"
                style="@style/Widget.App.PickerAction"
                android:text="@string/add_webapp"
                app:icon="@drawable/ic_symbols_add_24" />

        </LinearLayout>

    </HorizontalScrollView>

</LinearLayout>
