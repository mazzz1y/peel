<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".activities.WebAppSettingsActivity">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/settings_section_gap"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/margin_activity"
            android:fadeScrollbars="true"
            android:fillViewport="true"
            android:isScrollContainer="true"
            android:scrollbarFadeDuration="300"
            android:scrollbarStyle="outsideOverlay">

            <LinearLayout
                android:id="@+id/contentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/settings_hub_card_margin_horizontal"
                android:layout_marginEnd="@dimen/settings_hub_card_margin_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/sectionMainSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include layout="@layout/include_settings_icon_title_url" />

                    <LinearLayout
                        android:id="@+id/settingsRowsGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/groupRow"
                            style="@style/SettingsSurfaceRow.Inline"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/group"
                                android:textAppearance="?attr/textAppearanceBodyLarge" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnGroupPicker"
                                style="@style/SettingsTextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:maxWidth="@dimen/settings_dropdown_max_width"
                                android:text="@string/ungrouped" />

                        </LinearLayout>

                        <include layout="@layout/include_settings_sandbox_rows" />

                    </LinearLayout>

                </LinearLayout>

                <include layout="@layout/include_settings_override_section" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
