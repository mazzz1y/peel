<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <LinearLayout
        android:id="@+id/listPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            style="@style/Widget.App.TabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurfaceContainer"
            android:visibility="gone"
            app:tabGravity="start"
            app:tabIndicatorColor="?attr/colorPrimary"
            app:tabMode="scrollable"
            app:tabSelectedTextColor="?attr/colorPrimary"
            app:tabTextColor="?attr/colorOnSurfaceVariant" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </LinearLayout>

    <!-- Bottom-position results cover the tabs and the pager exactly, so a result row lands on
         the y of the list row it replaces and nothing shifts as search starts. URL suggestions
         float over the results' foot the way the bottom line does, on the same fade, resting
         one gap above the line; the list pads for them while they show. -->
    <FrameLayout
        android:id="@+id/bottomSearchResults"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/windowBackground"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/bottomSearchResultsList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/list_card_list_padding_top"
            android:paddingBottom="@dimen/list_bottom_fade_clearance" />

        <TextView
            android:id="@+id/bottomSearchEmptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/no_search_results"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <wtf.mazy.peel.ui.webapplist.UrlSuggestionStrip
            android:id="@+id/bottomSearchSuggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:paddingTop="@dimen/bottom_line_fade"
            android:paddingBottom="@dimen/bottom_line_rest_clearance"
            android:visibility="gone" />

    </FrameLayout>

    <!-- The bottom line of the Bottom search position floats over the list as the page's last
         child: the search bar while it is shown, and the floating action. The line takes the
         navigation bar and the keyboard as its own bottom padding, so it rides the keyboard;
         its top padding is the bar's fade, which the surface shows with the bar. -->
    <LinearLayout
        android:id="@+id/bottomLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/bottom_line_gap"
        android:paddingTop="@dimen/bottom_line_fade"
        android:paddingBottom="@dimen/bottom_line_gap"
        android:visibility="gone">

        <wtf.mazy.peel.ui.webapplist.SearchBar
            android:id="@+id/searchBar"
            style="@style/Widget.App.SearchBar"
            android:layout_width="0dp"
            android:layout_height="@dimen/bottom_line_height"
            android:layout_weight="1"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/bottomLineFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/bottom_line_gap"
            android:contentDescription="@string/search"
            app:hideMotionSpec="@animator/bottom_line_fab_hide"
            app:srcCompat="@drawable/ic_symbols_search_24" />

    </LinearLayout>

</FrameLayout>
