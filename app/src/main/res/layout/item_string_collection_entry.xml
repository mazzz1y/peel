<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/SettingsSurfaceRow.Line">

    <ImageView
        android:id="@+id/imageEntryKind"
        android:layout_width="@dimen/settings_icon_slot_width"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:tint="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/textEntryValue"
        style="@style/SettingsEntryText"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="@dimen/settings_entry_min_height" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRemoveEntry"
        style="@style/SettingsIconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/remove"
        app:icon="@drawable/ic_symbols_close_24" />

</LinearLayout>
