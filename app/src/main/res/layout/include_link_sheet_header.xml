<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/linkSheetHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/linkSheetTarget"
        style="@style/Widget.App.LinkSheetTarget">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/bottom_line_height"
            android:orientation="horizontal"
            android:paddingStart="@dimen/list_card_padding_horizontal"
            android:paddingEnd="@dimen/link_sheet_target_padding_end">

            <ImageView
                android:id="@+id/linkSheetTargetIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                app:tint="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/list_card_padding_horizontal"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingVertical="@dimen/link_sheet_target_padding_vertical">

                <TextView
                android:id="@+id/linkSheetTargetTitle"
                style="@style/LinkSheetTargetLine"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface" />

                <TextView
                android:id="@+id/linkSheetTargetAddress"
                style="@style/LinkSheetTargetLine"
                android:ellipsize="middle"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textDirection="ltr" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/linkSheetShare"
                style="@style/Widget.App.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/share"
                app:icon="@drawable/ic_symbols_share_wght300_24" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Only one of the two scrolls at a time: this one when the groups share a line, each group
         sized to its buttons; a group's own when it has a line to itself, this one then the
         sheet's width. -->
    <HorizontalScrollView
        android:id="@+id/linkSheetActionsScroll"
        style="@style/LinkSheetActionRow"
        android:layout_marginTop="@dimen/link_sheet_actions_margin_top"
        android:layout_marginBottom="@dimen/link_sheet_actions_margin_bottom"
        android:fillViewport="true"
        tools:ignore="NestedScrolling">

        <wtf.mazy.peel.ui.linksheet.LinkSheetActionLines
            android:id="@+id/linkSheetActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <HorizontalScrollView
                android:id="@+id/linkSheetOpenRowScroll"
                style="@style/LinkSheetActionRow">

                <LinearLayout
                    android:id="@+id/linkSheetOpenRow"
                    style="@style/LinkSheetActionRowButtons">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/linkSheetThisWindow"
                        style="@style/Widget.App.LinkSheetAction"
                        android:text="@string/this_window"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/linkSheetIncognito"
                        style="@style/Widget.App.LinkSheetAction"
                        android:text="@string/incognito"
                        app:icon="@mipmap/ic_launcher"
                        app:iconTint="@null" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/linkSheetSystem"
                        style="@style/Widget.App.LinkSheetAction"
                        android:text="@string/open_in_system"
                        android:visibility="gone"
                        app:icon="@drawable/ic_symbols_open_in_new_24" />

                </LinearLayout>

            </HorizontalScrollView>

            <HorizontalScrollView
                android:id="@+id/linkSheetLinkRowScroll"
                style="@style/LinkSheetActionRow">

                <LinearLayout
                    android:id="@+id/linkSheetLinkRow"
                    style="@style/LinkSheetActionRowButtons">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/linkSheetAdd"
                        style="@style/Widget.App.LinkSheetAction"
                        android:text="@string/add_to_peel"
                        app:icon="@drawable/ic_symbols_add_24" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/linkSheetSearch"
                        style="@style/Widget.App.LinkSheetAction"
                        android:text="@string/search"
                        android:visibility="gone"
                        app:icon="@drawable/ic_symbols_search_24" />

                </LinearLayout>

            </HorizontalScrollView>

            <HorizontalScrollView
                android:id="@+id/linkSheetImageRowScroll"
                style="@style/LinkSheetActionRow">

                <LinearLayout
                    android:id="@+id/linkSheetImageRow"
                    style="@style/LinkSheetActionRowButtons">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/linkSheetDownloadImage"
                        style="@style/Widget.App.LinkSheetAction"
                        android:text="@string/download_image"
                        app:icon="@drawable/ic_symbols_download_24" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/linkSheetShareImage"
                        style="@style/Widget.App.LinkSheetAction"
                        android:text="@string/share_image"
                        app:icon="@drawable/ic_symbols_share_24" />

                </LinearLayout>

            </HorizontalScrollView>

        </wtf.mazy.peel.ui.linksheet.LinkSheetActionLines>

    </HorizontalScrollView>

</LinearLayout>
