<?xml version="1.0" encoding="utf-8"?>
<!-- The line rides the keyboard, which search raises at the tap, so any exit would play out
     wherever the line has risen to. The action leaves in one frame, before the line moves. -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <objectAnimator
        android:propertyName="opacity"
        android:duration="0" />
    <objectAnimator
        android:propertyName="scale"
        android:duration="0" />
    <objectAnimator
        android:propertyName="iconScale"
        android:duration="0" />
</set>
