{
  "manifest_version": 2,
  "name": "Peel Certificate Store",
  "version": "1",
  "browser_specific_settings": {
    "gecko": {
      "id": "cert-store@peel.mazy.wtf"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "experiment_apis": {
    "peelCerts": {
      "schema": "schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "script": "parent.js",
        "paths": [
          [
            "peelCerts"
          ]
        ]
      }
    }
  },
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging"
  ]
}
